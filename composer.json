{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simplysmart/polygon",
    "type": "library",
    "description": "Polygon: rdzeń bazy danych aplikacji simplysmart (kolumny standardowe, historia zmian, pule id, tabele strefy, słowniki lokalizacji z seederami) oraz narzędzia deweloperskie (wydania SemVer, wdrożenia przed-produkcja → produkcja).",
    "keywords": [
        "simplysmart",
        "polygon",
        "database",
        "migrations",
        "localization",
        "dev",
        "tools",
        "deploy",
        "release"
    ],
    "homepage": "https://github.com/marcinulezalka/simplysmart-polygon",
    "license": "proprietary",
    "authors": [
        {
            "name": "Marcin Ulezalka",
            "email": "marcin.ulezalka@simplysmart.pl",
            "role": "Founder"
        }
    ],
    "support": {
        "issues": "https://github.com/marcinulezalka/simplysmart-polygon/issues",
        "source": "https://github.com/marcinulezalka/simplysmart-polygon"
    },
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "laravel/framework": "^13.0",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Simplysmart\\Polygon\\Database\\Seeders\\": "database/seeders/",
            "Simplysmart\\Polygon\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Simplysmart\\Polygon\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/composer-private",
        "bin/deploy",
        "bin/version-release"
    ],
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simplysmart\\Polygon\\PolygonServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
